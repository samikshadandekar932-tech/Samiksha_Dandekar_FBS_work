#include <stdio.h>

void checkNumber(int num);

int main()
{
    int num;

    printf("Enter a number: ");
    scanf("%d", &num);

    checkNumber(num);

    return 0;
}

void checkNumber(int num)
{
    if (num > 0)
        printf("Positive Number");
    else if (num < 0)
        printf("Negative Number");
    else
        printf("Zero (Neutral Number)");
}
