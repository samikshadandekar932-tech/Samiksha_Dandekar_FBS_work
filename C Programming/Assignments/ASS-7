1. Find minimum and maximum number in array.
#include<stdio.h>
int main()
{
	int arr[100], n, i;
	int max, min;
	printf("Enter size of array:");
	scanf("%d", &n);
	printf("Enter array element:\n");
	for(i = 0; i < n; i++)
	{
		scanf("%d",&arr[i]);
	}
	max = arr[0];
	min = arr[0];
	for( i = 1; i < n; i++)
	{
		if(arr[i] > max)
			max = arr[i];
			if(arr[i]<min)
			min = arr[i];
		
	}
	printf("Maximum = %d\n",max);
	printf("Minimum = %d\n",min);
	return 0;
	
}
2. Search the given number in array.
#include <stdio.h>

void searchNumber(int arr[], int n, int key);

int main()
{
    int arr[100], n, i, key;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    printf("Enter number to search: ");
    scanf("%d", &key);

    searchNumber(arr, n, key);

    return 0;
}

void searchNumber(int arr[], int n, int key)
{
    int i;

    for(i = 0; i < n; i++)
    {
        if(arr[i] == key)
        {
            printf("%d found at index %d", key, i);
            return;
        }
    }

    printf("%d not found.", key);
}
3. Find sum of all numbers.
#include <stdio.h>

int findsum();

int main()
{
    int sum;

    sum = findsum();

    printf("Sum = %d", sum);

    return 0;
}

int findsum()
{
    int arr[100], n, i;
    int sum = 0;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    for(i = 0; i < n; i++)
    {
        sum = sum + arr[i];
    }

    return sum;
}
