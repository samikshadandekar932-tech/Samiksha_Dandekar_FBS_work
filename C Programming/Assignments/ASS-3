6 Check the given number is Perfect number or not.
Input: n = 28
#include <stdio.h>

int main() {
    int num=28, i = 1, sum = 0;

    while (i < num) {
        if (num % i == 0) {
            sum = sum + i;
        }
        i++;
    }

    if (sum == num)
        printf("%d Perfect ", num);
    else
        printf("%d is not a Perfect Number.", num);

    return 0;
}
7 Find factorial of given number.
