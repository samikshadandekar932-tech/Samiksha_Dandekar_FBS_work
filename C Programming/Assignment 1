2. Write a program to check given 3 digit number is pallindrome or not.
#include <stdio.h>

int main() {
    int num = 121;
    int original, rev;
    int a, b, c;

    original = num;

    a = num / 100;        // first digit
    b = (num / 10) % 10;  // middle digit
    c = num % 10;         // last digit

    rev = c * 100 + b * 10 + a;

    if (original == rev) {
        printf("Palindrome number");
    } else {
        printf("Not a palindrome number");
    }

    return 0;
}
